{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // "node" is needed by the integration test, which drives the real relay
    // from Node using the same core code the browser runs.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "e2e", "playwright.config.ts", "vite.config.ts", "vitest.config.ts"]
}
