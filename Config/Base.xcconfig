// Build settings shared by every configuration.
//
// Note: "//" starts a comment in an xcconfig, so a full URL cannot be written
// here. Scheme and host are kept separate and joined in Info.plist, where the
// slashes are harmless.

// The deployed Cloudflare backend. Every build — simulator, device, and
// TestFlight — talks to the hosted relay over wss. (The old localhost/LAN
// scheme via a per-machine xcconfig is retired, and its script is deleted: it
// silently shipped a dev machine's LAN address into TestFlight, so every
// request hung.)
RELAY_SCHEME = wss
RELAY_HOST = tiktokforwork.torubj0904.workers.dev
