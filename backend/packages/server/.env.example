# HTTP + WebSocket port
PORT=8081

# SQLite file (created on boot). Use an absolute path in production.
DATABASE_PATH=data/honmaru.db

# pino level: trace|debug|info|warn|error
LOG_LEVEL=info

# Session token lifetime
SESSION_TTL_DAYS=30

# 1 = enable POST /v1/auth/dev (name-only login for local dev / demos).
# NEVER enable in production.
AUTH_DEV_MODE=1

# Optional: POST every notification to this URL (push relay / ntfy / Slack
# webhook). Leave empty to use in-app delivery only.
NOTIFY_WEBHOOK_URL=

# GitHub OAuth app (sign-in). Leave empty to run with dev login only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=tiktokforwork://oauth/callback

# Reverse sync: GitHub webhook (issues events) -> card status. Configure the
# repo webhook to POST to /v1/webhooks/github with this secret.
GITHUB_WEBHOOK_SECRET=

# OpenRouter (AI routing). Leave empty to use the deterministic fallback router.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_APP_NAME=HonmaruAI
OPENROUTER_APP_URL=http://localhost:8081
