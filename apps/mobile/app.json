{
  "expo": {
    "name": "Honmaru",
    "slug": "honmaru",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.honmaru.ai.poc",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:app.honmaruai.com"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#202020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.honmaru.ai.poc",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "app.honmaruai.com", "pathPrefix": "/c/" },
            { "scheme": "https", "host": "app.honmaruai.com", "pathPrefix": "/join/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#202020",
          "defaultChannel": "messages"
        }
      ],
      "expo-apple-authentication"
    ],
    "scheme": "honmaru",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBase": "https://tiktokforwork.torubj0904.workers.dev"
    }
  }
}
