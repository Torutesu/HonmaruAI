# Backend origin. A bare host is also accepted; its scheme follows the page.
# Local development defaults to http://localhost:8787 without this variable.
# For a separately hosted production API, set its HTTPS origin at build time:
# VITE_API_HOST=https://api.example.com
# A production build without VITE_API_HOST uses the web page's own origin.

# Enable the diagnostic event log only when investigating a problem.
VITE_DEBUG=false
