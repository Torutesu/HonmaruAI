# Copy to .asc.env and fill in. .asc.env is gitignored — never commit it.
# Used by scripts/release.sh

# --- App Store Connect API key (App Store Connect > Users and Access > Integrations > App Store Connect API) ---
ASC_KEY_ID=
ASC_ISSUER_ID=
# Path to the .p8 you downloaded. Apple lets you download it exactly once.
ASC_PRIVATE_KEY=$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
# Name this credential is stored under in the asc keychain (asc auth list)
ASC_PROFILE=HonmaruAI

# --- App identity ---
# Numeric App Store Connect app id. Find it with: asc apps list --output table
ASC_APP_ID=
ASC_BUNDLE_ID=com.honmaru.ai

# --- Signing ---
# Apple Developer Team ID (10 chars). project.yml leaves DEVELOPMENT_TEAM empty,
# so release.sh injects this value into xcodebuild.
DEVELOPMENT_TEAM=

# --- Defaults ---
ASC_LOCALE=en-US
ASC_SCHEME=HonmaruAI
