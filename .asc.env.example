# Copy to .asc.env and fill in. Gitignored — never commit the real one.
#
# `scripts/setup.sh` writes this file for you interactively, which is the
# easier route; this exists so you can see what it is going to ask for, and so
# `release.sh` has something real to point at when it is missing.

# App Store Connect API key, from Users and Access → Integrations → App Store
# Connect API. The key is downloadable exactly once.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Path to the .p8 you downloaded. A path, not the key itself.
ASC_PRIVATE_KEY=$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# The app's numeric id in App Store Connect, from the URL of its page there.
ASC_APP_ID=
ASC_BUNDLE_ID=com.honmaru.ai

# Apple Developer team id, from developer.apple.com → Membership.
DEVELOPMENT_TEAM=

# The provisioning profile's name, as it appears in the developer portal.
ASC_PROFILE=HonmaruAI
# The Xcode scheme. The project name from project.yml, not the product name.
ASC_SCHEME=TikTokForWork
ASC_LOCALE=en-US
