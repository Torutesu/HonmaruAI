    "This is from a private conversation, so only a link goes. Whoever can read the original can open it.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開の会話のメッセージなので、リンクだけを送ります。元の会話を読める人だけが開けます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es de una conversación privada, así que solo va un enlace. Quien pueda leer el original podrá abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vient d’une conversation privée : seul un lien part. Qui peut lire l’original pourra l’ouvrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das stammt aus einer privaten Unterhaltung, daher geht nur ein Link. Wer das Original lesen darf, kann ihn öffnen."
          }
        }
      }
    },
