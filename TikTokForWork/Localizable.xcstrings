    "Tell your AI — e.g. ask Yuki to approve the spring menu by Friday": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：春のメニューを金曜までに承認してほしいと田中さんに依頼して"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag es deiner KI – z. B. bitte Yuki, das Frühlingsmenü bis Freitag freizugeben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à votre IA — p. ex. demandez à Yuki d’approuver le menu de printemps d’ici vendredi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a tu IA — p. ej. pide a Yuki que apruebe el menú de primavera para el viernes"
          }
        }
      }
    },
    "The complete original request is retained with this summary.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の依頼の全文は、この要約と一緒に保持されます。"
