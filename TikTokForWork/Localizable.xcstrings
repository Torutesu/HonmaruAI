    "Camera access is off. Enable it in Settings or use dictation.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスが無効です。設定で許可するか、音声入力を使ってください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist aus. Aktiviere ihn in den Einstellungen oder nutze die Diktierfunktion."
