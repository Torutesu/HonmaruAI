    "Tanaka asked to continue past the current contract at the same rate. Your rate has since gone up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanaka hat gebeten, über den aktuellen Vertrag hinaus zum gleichen Satz weiterzumachen. Dein Satz ist seitdem gestiegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanaka pidió continuar tras el contrato actual a la misma tarifa. Tu tarifa ha subido desde entonces."
