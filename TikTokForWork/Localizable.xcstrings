    "Accounting AI drafted a reminder. The client is one you want to keep, so the wording matters.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Buchhaltungs-KI hat eine Erinnerung entworfen. Es ist ein Kunde, den du halten willst — der Ton zählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA de contabilidad redactó un recordatorio. Es un cliente que quieres conservar, así que el tono importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA comptable a rédigé une relance. C’est un client à conserver, donc la formulation compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経理AI が催促文を用意しました。今後も付き合いたい相手なので、文面が重要です。"
          }
        }
      }
    },
    "Accounting AI found ¥18,400 of subscriptions renewing, two of which you have not opened in 60 days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Buchhaltungs-KI hat ¥18.400 an sich verlängernden Abos gefunden — zwei davon hast du seit 60 Tagen nicht geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA de contabilidad encontró ¥18,400 en suscripciones que se renuevan; dos no las has abierto en 60 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA comptable a trouvé ¥18 400 d’abonnements qui se renouvellent, dont deux non ouverts depuis 60 jours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経理AI が ¥18,400 の更新を検出しました。うち2つは60日間開いていません。"
          }
        }
      }
    },
    "Accounting AI reconciled every receipt and found two it cannot categorise. Filing closes in three days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Buchhaltungs-KI hat alle Belege abgeglichen und zwei gefunden, die sie nicht zuordnen kann. Die Abgabe schließt in drei Tagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
