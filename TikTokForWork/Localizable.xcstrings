          }
        }
      }
    },
    "Dictate request": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声で依頼を入力"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfrage diktieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicter la demande"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictar solicitud"
          }
        }
      }
    },
    "Camera preview": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラのプレビュー"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameravorschau"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu de la caméra"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa de la cámara"
          }
        }
      }
    },
    "Video is silent. Your speech is added as an editable transcript.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画に音声は含まれません。話した内容は編集可能なテキストとして追加されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video ist stumm. Was du sagst, wird als bearbeitbares Transkript hinzugefügt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo est muette. Vos paroles sont ajoutées sous forme de transcription modifiable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo no tiene sonido. Lo que digas se añade como una transcripción editable."
          }
        }
      }
    },
    "Speak your request, then review the transcript before adding it to your draft.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したいことを話してください。文字起こしを確認してから下書きに追加できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich deine Anfrage und prüfe das Transkript, bevor du es deinem Entwurf hinzufügst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Énoncez votre demande, puis relisez la transcription avant de l’ajouter à votre brouillon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di tu solicitud y revisa la transcripción antes de añadirla a tu borrador."
          }
        }
      }
    },
    "Speech is transcribed on this device only. When you generate an AI draft, the text is sent to OpenAI, not your microphone audio. If on-device recognition is unavailable, type your request instead.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は端末内だけで文字起こしします。AIで下書きを生成すると、文字起こししたテキストがOpenAIに送信されます。マイクの音声は送信しません。端末内の音声認識が使えない場合は、文字で入力してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache wird nur auf diesem Gerät transkribiert. Wenn du einen KI-Entwurf erstellst, wird der Text an OpenAI gesendet, nicht die Mikrofonaufnahme. Ist die Erkennung auf dem Gerät nicht verfügbar, tippe deine Anfrage stattdessen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La parole est transcrite uniquement sur cet appareil. Si vous générez un brouillon avec l’IA, c’est le texte qui est envoyé à OpenAI, pas l’audio du micro. Si la reconnaissance sur l’appareil n’est pas disponible, saisissez plutôt votre demande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz se transcribe solo en este dispositivo. Al generar un borrador con IA, se envía el texto a OpenAI, no el audio del micrófono. Si el reconocimiento en el dispositivo no está disponible, escribe tu solicitud."
          }
        }
      }
    },
    "Ready when you are": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備ができたら開始してください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit, wenn du es bist"
          }
        },
        "fr": {
