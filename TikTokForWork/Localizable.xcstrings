    "Reconnect before saving a response.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が戻ってから回答を保存してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich neu, bevor du eine Antwort speicherst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous avant d’enregistrer une réponse."
