{
  "sourceLanguage": "en",
  "strings": {
    "A lead went quiet for ten days": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見込み客が10日間音沙汰なし"
          }
        }
      }
    },
    "A work feed where nothing needs reading twice. Your AI turns your team's asks, approvals, and tasks into cards you clear in seconds.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二度読む必要のない仕事のフィード。チームの依頼・承認・タスクを、AI が数秒で片づけられるカードに変えます。"
          }
        }
      }
    },
    "AI returned an invalid routing response.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI の応答を解釈できませんでした。"
          }
        }
      }
    },
    "AI routing is not configured on the relay server.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーサーバーで AI ルーティングが設定されていません。"
          }
        }
      }
    },
    "AI routing request failed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ルーティングの呼び出しに失敗しました。"
          }
