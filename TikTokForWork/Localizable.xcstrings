{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "A work feed where nothing needs reading twice. Your AI turns your team's asks, approvals, and tasks into cards you clear in seconds.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二度読む必要のない仕事のフィード。チームの依頼・承認・タスクを、AI が数秒で片づけられるカードに変えます。"
          }
        }
      }
    },
    "Approval": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認"
          }
        }
      }
    },
    "Approve": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認する"
          }
        }
      }
    },
    "Approve the Friday release?": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金曜のリリースを承認しますか？"
          }
        }
      }
