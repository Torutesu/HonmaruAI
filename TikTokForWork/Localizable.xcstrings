        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードがなくても自分のワークスペースを作成して、メンバーを招待できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Code? Du bekommst einen eigenen Workspace und kannst andere einladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de code ? Vous obtenez un espace à vous et pouvez y inviter d’autres personnes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No tienes código? Tendrás tu propio espacio de trabajo y podrás invitar a otras personas."
          }
        }
      }
    },
    "Nothing settled yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ完了した依頼はありません。"
