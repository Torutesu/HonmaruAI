        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand quelqu’un écrit @ suivi de votre nom, ou répond dans un fil auquel vous participez, cela s’affiche ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jemand @ und deinen Namen schreibt oder in einem Thread antwortet, an dem du beteiligt bist, erscheint es hier."
          }
