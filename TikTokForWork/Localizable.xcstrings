    "While paused, nothing reaches your phone, browser or inbox. It all waits in Activity.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止中はスマホ・ブラウザ・メールに通知しません。届いたものはアクティビティに残ります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa, nada llega a tu móvil, navegador ni correo. Todo te espera en Actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause, rien n’arrive sur votre téléphone, votre navigateur ni par e-mail. Tout vous attend dans Activité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Pause erreicht dich nichts auf Handy, Browser oder per Mail. Alles wartet in Aktivität."
          }
        }
      }
    },
