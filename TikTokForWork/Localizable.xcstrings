    "Each person has their own AI — and sees only the decisions that are theirs to make. You can switch anytime from the feed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Person hat ihre eigene KI — und sieht nur die Entscheidungen, die sie zu treffen hat. Du kannst jederzeit im Feed wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada persona tiene su propia IA — y ve solo las decisiones que le tocan. Puedes cambiar en cualquier momento desde el feed."
