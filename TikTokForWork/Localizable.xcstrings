    },
    "A lead went quiet for ten days": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lead ist seit zehn Tagen still"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cliente potencial lleva diez días en silencio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un prospect est resté silencieux pendant dix jours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見込み客が10日間音沙汰なし"
          }
        }
      }
    },
    "A work feed where nothing needs reading twice. Your AI turns your team's asks, approvals, and tasks into cards you clear in seconds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Arbeits-Feed, in dem nichts zweimal gelesen werden muss. Deine KI verwandelt Anfragen, Freigaben und Aufgaben deines Teams in Karten, die du in Sekunden erledigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un feed de trabajo donde nada hay que leer dos veces. Tu IA convierte las peticiones, aprobaciones y tareas de tu equipo en tarjetas que resuelves en segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fil de travail où rien ne se lit deux fois. Votre IA transforme les demandes, approbations et tâches de votre équipe en cartes que vous réglez en quelques secondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二度読む必要のない仕事のフィード。チームの依頼・承認・タスクを、AI が数秒で片づけられるカードに変えます。"
          }
        }
      }
    },
    "AI returned an invalid routing response.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI hat eine ungültige Routing-Antwort zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA devolvió una respuesta de enrutado no válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA a renvoyé une réponse d’acheminement invalide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI の応答を解釈できませんでした。"
          }
        }
      }
    },
    "AI routing is not configured on the relay server.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Routing ist auf dem Relay-Server nicht konfiguriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enrutado por IA no está configurado en el servidor relay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acheminement par IA n’est pas configuré sur le serveur relais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーサーバーで AI ルーティングが設定されていません。"
          }
        }
      }
    },
    "AI routing request failed.": {
      "extractionState": "manual",
      "localizations": {
