        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisarme cuando se digan estas palabras en cualquier conversación que pueda leer, como si me hubieran mencionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "M’avertir quand ces mots sont dits dans une conversation que je peux lire, comme si l’on m’avait mentionné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
