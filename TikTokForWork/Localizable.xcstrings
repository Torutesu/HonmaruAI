    },
    "The request will return to waiting. Changes already made in connected tools are not undone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼を判断待ちに戻します。連携ツールで行った変更は取り消されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage wartet dann wieder. Bereits in verbundenen Tools vorgenommene Änderungen werden nicht rückgängig gemacht."
