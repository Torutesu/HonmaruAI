    "You can close this screen and type your request instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面を閉じて、文字で入力することもできます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diesen Bildschirm schließen und deine Anfrage stattdessen tippen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez fermer cet écran et saisir votre demande au clavier."
