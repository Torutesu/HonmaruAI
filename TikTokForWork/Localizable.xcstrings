            "state": "translated",
            "value": "誰かが@であなたの名前を書いたり、参加中のスレッドに返信したりすると、ここに表示されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando alguien escriba @ y tu nombre, o responda en un hilo en el que participas, aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
