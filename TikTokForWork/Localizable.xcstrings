    "Use your own OpenAI key for routing. It stays in this device's Keychain and is sent only with your own requests — we never store it on our servers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze deinen eigenen OpenAI-Schlüssel fürs Routing. Er bleibt im Schlüsselbund dieses Geräts und wird nur mit deinen eigenen Anfragen gesendet — wir speichern ihn nie auf unseren Servern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu propia clave de OpenAI para el enrutado. Permanece en el Keychain de este dispositivo y solo se envía con tus solicitudes — nunca la guardamos en nuestros servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre propre clé OpenAI pour l’acheminement. Elle reste dans le Trousseau de cet appareil et n’est envoyée qu’avec vos requêtes — nous ne la stockons jamais sur nos serveurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティングにご自身の OpenAI キーを使えます。キーはこの端末のキーチェーンにのみ保存され、あなたのリクエストにのみ送信されます。当方のサーバーには保存しません。"
          }
        }
      }
    },
