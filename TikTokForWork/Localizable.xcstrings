        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのタイムゾーンで判定します。時間外は一時停止と同じく通知しません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu zona horaria. Fuera de ese horario no hay avisos, como en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans votre fuseau horaire. En dehors, c’est silencieux, comme en pause."
