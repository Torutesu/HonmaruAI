        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande repassera en attente. Les modifications déjà faites dans les outils connectés ne sont pas annulées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud volverá a estar pendiente. Los cambios ya hechos en herramientas conectadas no se deshacen."
          }
        }
      }
    },
    "The response is not confirmed yet. Check the request before retrying.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
