      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        }
      }
    },
    "Accounting AI drafted a reminder. The client is one you want to keep, so the wording matters.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経理AI が催促文を用意しました。今後も付き合いたい相手なので、文面が重要です。"
          }
        }
      }
    },
    "Accounting AI found ¥18,400 of subscriptions renewing, two of which you have not opened in 60 days.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経理AI が ¥18,400 の更新を検出しました。うち2つは60日間開いていません。"
          }
        }
      }
    },
    "Accounting AI reconciled every receipt and found two it cannot categorise. Filing closes in three days.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経理AI が全ての領収書を照合し、分類できないものが2件見つかりました。申告期限まで3日です。"
          }
        }
      }
    },
