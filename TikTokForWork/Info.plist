<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tangle.tiktokforwork.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tiktokforwork</string>
			</array>
		</dict>
	</array>
	<!-- Assembled from Config/Base.xcconfig; see AppConfig.relayURL. Scheme and
	     host are separate build settings because "//" starts a comment in an
	     xcconfig and cannot appear in a value there. -->
	<key>RelayURL</key>
	<string>$(RELAY_SCHEME)://$(RELAY_HOST)</string>
	<!-- The relay speaks plain ws:// on the LAN, which App Transport Security
	     blocks by default. NSAllowsLocalNetworking exempts private and
	     link-local addresses only — public hosts still require HTTPS, so this
	     does not weaken the app once the relay is hosted behind wss://. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The app only uses the encryption Apple exempts: the OS's own TLS.
	     Without this key every upload parks in Missing Compliance and testers
	     cannot install the build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Record a short video so your teammate can see what you mean.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record what you say so your AI can turn it into a decision.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn what you say into the instruction your AI routes.</string>
</dict>
</plist>
