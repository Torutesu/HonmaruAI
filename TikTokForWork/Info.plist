<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tangle.tiktokforwork.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tiktokforwork</string>
			</array>
		</dict>
	</array>
	<!-- Assembled from Config/Base.xcconfig; see AppConfig.relayURL. Scheme and
	     host are separate build settings because "//" starts a comment in an
	     xcconfig and cannot appear in a value there. -->
	<!-- Capture (A5) dictates instead of typing. Both keys are required before
	     the Speech framework will start, and iOS terminates the app on the
	     first request if either is missing. -->
	<!-- The capture screen shows you on camera while you talk. The video is a
	     viewfinder only: nothing is recorded to disk or sent anywhere, and only
	     the transcript leaves the screen. -->
	<key>NSCameraUsageDescription</key>
	<string>話しているあなたを画面に映すために使います。映像は保存も送信もされません。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>AI に話しかけて指示を伝えるために使います。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>話した内容を文字にして、送る前に確認できるようにします。</string>
	<key>RelayURL</key>
	<string>$(RELAY_SCHEME)://$(RELAY_HOST)</string>
	<!-- The relay speaks plain ws:// on the LAN, which App Transport Security
	     blocks by default. NSAllowsLocalNetworking exempts private and
	     link-local addresses only — public hosts still require HTTPS, so this
	     does not weaken the app once the relay is hosted behind wss://. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The app only uses the encryption Apple exempts: the OS's own TLS.
	     Without this key every upload parks in Missing Compliance and testers
	     cannot install the build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
