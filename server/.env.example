GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=tiktokforwork://oauth/callback
GITHUB_OAUTH_SCOPE=repo
PORT=8080

# HMAC secret for GitHub webhooks (repo Settings → Webhooks → Secret).
# The /github/webhook endpoint verifies X-Hub-Signature-256 with this.
# Leave empty only in local development.
GITHUB_WEBHOOK_SECRET=

# Shared secret for the relay. Leave empty for localhost development.
# REQUIRED for any deploy reachable from the internet — the app sends it as
# a Bearer token (HTTP) and in the WebSocket join payload.
RELAY_TOKEN=

# Where decision cards / channels / org are persisted across restarts (JSON files).
CARDS_STORE_PATH=./data/cards.json
CHANNELS_STORE_PATH=./data/channels.json
ORG_STORE_PATH=./data/org.json
PUSH_STORE_PATH=./data/push.json
DIGEST_STORE_PATH=./data/digest.json

# Periodic channel digests as feed cards (minutes; 0 = off).
# POST /digest/run triggers one on demand regardless.
DIGEST_INTERVAL_MINUTES=0

# SLA before a pending card escalates to the recipient's manager.
# Defaults: urgent:120, high:480, medium:1440 (low never escalates).
SLA_MINUTES=
# Sweep frequency in minutes (0 = off). POST /escalations/run works regardless.
ESCALATION_INTERVAL_MINUTES=15

# APNs push notifications (optional — needs an Apple Developer p8 key).
# Only pending high/urgent decision cards are pushed, and never to users
# who are currently connected. Leave empty to disable.
# APNS_KEY_P8 takes the key inline (\n for newlines) or use APNS_KEY_PATH.
APNS_KEY_P8=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tangle.tiktokforwork
# sandbox (default) or production
APNS_ENV=sandbox

OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_APP_NAME=TikTok for Work
OPENROUTER_APP_URL=http://localhost:8080
