GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=tiktokforwork://oauth/callback
GITHUB_OAUTH_SCOPE=repo
PORT=8080

OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_APP_NAME=TikTok for Work
OPENROUTER_APP_URL=http://localhost:8080

# Either one enables AI routing. OPENAI_API_KEY wins if both are set.
# Override the model with OPENAI_MODEL (default: gpt-4o-mini).
OPENAI_API_KEY=
OPENAI_MODEL=

# Email connector (POST /webhooks/email, see PROGRESS.md Phase 9).
# Required in production so webhook signatures actually get verified.
MAILGUN_WEBHOOK_SIGNING_KEY=
# NEVER set this to 1 in production — it disables signature verification
# entirely for requests with no signature fields, which is otherwise
# rejected by default. Only for local/manual testing with curl.
ALLOW_UNSIGNED_EMAIL_WEBHOOK=
# Stand-in for real To:-address/org-membership routing: every
# decision-worthy email is routed to this user if set, else the first user
# in the org's store.
EMAIL_DEFAULT_RECIPIENT_USER_ID=
